# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret
.env
.env.*
!.env.example

# Git & CI
.git
.gitignore
.github

# Môi trường Python cục bộ
.venv
venv
env

# Cache / build
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Không cần trong image
tests
screenshots
*.md
Dockerfile
docker-compose.yml
.dockerignore
.vscode
.idea
